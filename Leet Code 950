class Solution {
public:
    vector<int> deckRevealedIncreasing(vector<int>& deck) {
        int n = deck.size();
        sort(deck.begin(), deck.end());

        queue<int> q;
        for(int i = 0; i < n; i++) q.push(i);

        vector<int> result(n);
        int cardIndex = 0;

        while(!q.empty()){
            int revealPos = q.front();
            q.pop();
            result[revealPos] = deck[cardIndex++];

            if(!q.empty()){
                q.push(q.front());
                q.pop();
            }
        }
        return result;
        
    }
};
