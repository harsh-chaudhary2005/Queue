class Solution {
public:
    int timeRequiredToBuy(vector<int>& tickets, int k) {
        queue<pair<int,int>> q;
        int t = 0;
        for(int i = 0; i < tickets.size(); i++){
            q.push({tickets[i], i});
        }
        while(!q.empty()){
            auto [count, idx] = q.front();
            q.pop();
            t++;
            count--;

            if(count == 0){
                if(idx == k) return t;
            } else {
                q.push({count, idx});
            }
        }
        return t;
    }
};
